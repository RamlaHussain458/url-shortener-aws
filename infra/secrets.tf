# The database password is generated by Terraform and stored in Systems Manager Parameter Store
# as an encrypted value. It is never written in the code or in Git. The server reads these
# parameters when the application is deployed.
resource "random_password" "db" {
  length  = 24
  special = false
}

resource "aws_ssm_parameter" "db_password" {
  name        = "/${var.project_name}/db/password"
  description = "Database password for the application"
  type        = "SecureString"
  value       = random_password.db.result
}

resource "aws_ssm_parameter" "db_host" {
  name        = "/${var.project_name}/db/host"
  description = "Database endpoint address"
  type        = "String"
  value       = aws_db_instance.main.address
}

resource "aws_ssm_parameter" "db_name" {
  name        = "/${var.project_name}/db/name"
  description = "Database name"
  type        = "String"
  value       = var.db_name
}

resource "aws_ssm_parameter" "db_user" {
  name        = "/${var.project_name}/db/user"
  description = "Database user"
  type        = "String"
  value       = var.db_username
}
